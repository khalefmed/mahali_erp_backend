# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-not-secret-0123456789abcdef0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://mahali:mahali@localhost:5433/mahali
REDIS_URL=redis://localhost:6381/0
# Where links in emails point (password reset, invitations)
WEB_APP_URL=http://localhost:3000
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Mahali <no-reply@mahali.infinity.mr>
# Check new passwords against Have I Been Pwned (k-anonymity API)
PWNED_PASSWORDS_CHECK=false
SENTRY_DSN=
# Django admin path; leave empty to disable the admin
DJANGO_ADMIN_PATH=admin/
