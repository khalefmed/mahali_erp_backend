# /opt/mahali/<env>/deploy/.env on the VPS. Generate secrets with: openssl rand -base64 48
MAHALI_ENV=staging
API_BIND=127.0.0.1:8010
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=api.staging.mahali.infinity.mr
DJANGO_DEBUG=false
SECURE_SSL_REDIRECT=true
WEB_APP_URL=https://staging.mahali.infinity.mr
# Gmail: smtp+tls://<address>%40gmail.com:<app password>@smtp.gmail.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=Mahali <no-reply@mahali.infinity.mr>
PWNED_PASSWORDS_CHECK=true
DJANGO_ADMIN_PATH=
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
