# API_DOMAIN = api.staging.mahali.infinity.mr → automatic HTTPS (Let's Encrypt).
# Before DNS exists, set API_DOMAIN=":80" to serve plain HTTP on the IP.
{$API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	reverse_proxy api:8000
}
